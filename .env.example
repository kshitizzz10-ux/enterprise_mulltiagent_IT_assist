# OpenAI Configuration (Optional: if empty, autonomous local fallback engine runs)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Storage & Knowledge Base
KB_FILE_PATH=data/company_kb.txt
CHROMA_PERSIST_DIR=data/chroma_db
CHROMA_COLLECTION_NAME=it_support_kb

# Chunking & Guardrails (PRD Specifications)
CHUNK_SIZE=250
CHUNK_OVERLAP=25
IP_REDACTION_TOKEN=[REDACTED IP]
